# Frontend build variable. Public origin only; safe to include in the client bundle.
# Set to your Render backend URL locally and in Vercel, e.g. http://localhost:10000
VITE_API_BASE_URL=http://localhost:10000

# Render backend variables. Never prefix these with VITE_.
SUPABASE_URL=https://your-project-ref.supabase.co

# Preferred current key format from Supabase Settings -> API Keys: sb_secret_...
SUPABASE_SECRET_KEY=

# Optional legacy fallback only if the project still uses the service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=

# Random secret to HMAC the Vercel/Render client IP before storing a short-lived rate-limit key.
# Generate using: openssl rand -hex 32
RATE_LIMIT_SECRET=

# Comma-separated exact Vercel production/custom origins, no trailing slash.
# Example: https://your-campaign.vercel.app,https://campaign.example.org
FRONTEND_ORIGINS=http://localhost:5173
